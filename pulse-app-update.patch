+
         var args = Arguments(_s, _encoder, gamePipe != null ? $@"\\.\pipe\{id}-game" : null, micPipe != null ? $@"\\.\pipe\{id}-mic" : null, _window,
             appPipes.Select(a => (a.Title, a.Pipe)).ToList(), TrackTitles, VideoLevel, StretchCanvas());
         _ffmpeg = Process.Start(Ffmpeg.Start(args, redirectOut: true))!;
@@ -205,6 +217,11 @@ public sealed class ReplayRecorder : IDisposable
         var a = new List<string> { "-hide_banner", "-loglevel", "warning", "-nostats" };
         int fps = Math.Clamp(s.Fps, 24, 240);
         int cursor = s.RecordCursor ? 1 : 0;
+        // Window capture is asked for twice the clip's frame rate. Asking for exactly 60 made Windows hold back any
+        // picture that came a hair under 1/60 s after the last one, so a 60 FPS clip got bursts of repeated frames
+        // (every third frame on a 120 Hz screen: judder). With twice as many to pick from, the steady-rate step below
+        // always has a fresh picture for each frame.
+        int grab = Math.Min(fps * 2, 480);
 
         // Input 0: grabbed on the graphics card. Either the game's own window (Windows Graphics Capture, which keeps
         // working when the game changes display mode or moves screens; no yellow border, size kept and rounded to even
@@ -213,9 +230,9 @@ public sealed class ReplayRecorder : IDisposable
