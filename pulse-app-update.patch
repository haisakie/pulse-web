diff --git a/src/PulseOptimizer/Core/Clips/DisplayScaling.cs b/src/PulseOptimizer/Core/Clips/DisplayScaling.cs
new file mode 100644
index 0000000..7b5a971
--- /dev/null
+++ b/src/PulseOptimizer/Core/Clips/DisplayScaling.cs
@@ -0,0 +1,126 @@
+using System.Diagnostics;
+using System.IO;
+using System.Runtime.InteropServices;
+
+namespace Pulse.Core.Clips;
+
+/// <summary>
+/// Whether a 4:3 (or other narrower) game on this screen is really shown stretched, or in the middle with black bars.
+/// Windows reports how each display's picture is fitted (stretched, centered, or kept in shape with bars), which is
+/// what the graphics driver's "Full-screen" / "Aspect ratio" scaling sets. VALORANT can also add its own black bars
+/// (its letterbox setting). Clips are only stretched when the game really is.
+/// </summary>
+public static class DisplayScaling
+{
+    // DISPLAYCONFIG_SCALING values.
+    public const int Identity = 1, Centered = 2, Stretched = 3, AspectRatio = 4, Custom = 5, Preferred = 128;
+
+    /// <summary>
+    /// Stretch the clip to the screen's shape? Not when the game draws its own black bars, nor when the display keeps
+    /// the picture's shape (bars) or centers it. Otherwise yes, as before: most drivers stretch by default.
+    /// </summary>
+    public static bool Stretches(int? scaling, bool? gameLetterbox) =>
+        gameLetterbox != true && scaling is not (Centered or AspectRatio);
+
+    /// <summary>How Windows fits pictures on the display a window is on (a DISPLAYCONFIG_SCALING value), or null.</summary>
+    public static int? ForWindow(IntPtr window)
+    {
+        if (!OperatingSystem.IsWindows() || window == IntPtr.Zero) return null;
+        try
+        {
+            var mi = new MONITORINFOEX { cbSize = Marshal.SizeOf<MONITORINFOEX>() };
+            if (!GetMonitorInfo(MonitorFromWindow(window, 2), ref mi)) return null;
+            return ForDevice(mi.szDevice);
+        }
+        catch { return null; }
+    }
+
+    /// <summary>How Windows fits pictures on the given display (\\.\DISPLAYn), or null.</summary>
+    public static int? ForDevice(string device)
+    {
+        if (!OperatingSystem.IsWindows() || string.IsNullOrEmpty(device)) return null;
+        try
+        {
+            const uint QDC_ONLY_ACTIVE_PATHS = 2;
+            if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, out uint np, out uint nm) != 0) return null;
+            var paths = new byte[np * PathSize];
+            var modes = new byte[nm * ModeSize];
+            if (QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, ref np, paths, ref nm, modes, IntPtr.Zero) != 0) return null;
+            for (int i = 0; i < np; i++)
+            {
+                int o = i * PathSize;
+                // sourceInfo: adapterId (LUID, 8 bytes), id. targetInfo starts at 20; its scaling is the 6th field after the LUID.
+                var name = new DISPLAYCONFIG_SOURCE_DEVICE_NAME
+                {
+                    type = 1, size = (uint)Marshal.SizeOf<DISPLAYCONFIG_SOURCE_DEVICE_NAME>(),
+                    adapterLow = BitConverter.ToUInt32(paths, o), adapterHigh = BitConverter.ToInt32(paths, o + 4), id = BitConverter.ToUInt32(paths, o + 8),
+                };
+                if (DisplayConfigGetDeviceInfo(ref name) != 0) continue;
+                if (!string.Equals(name.viewGdiDeviceName, device, StringComparison.OrdinalIgnoreCase)) continue;
+                return (int)BitConverter.ToUInt32(paths, o + 20 + 24);
+            }
+        }
+        catch { }
+        return null;
+    }
+
+    /// <summary>VALORANT's own letterbox setting (black bars around a narrower resolution), from its newest settings file.</summary>
+    public static bool? ValorantLetterbox()
+    {
+        try
+        {
+            var root = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "VALORANT", "Saved", "Config");
+            if (!Directory.Exists(root)) return null;
+            var newest = Directory.EnumerateFiles(root, "GameUserSettings.ini", SearchOption.AllDirectories)
+                .Select(f => new FileInfo(f)).OrderByDescending(f => f.LastWriteTimeUtc).FirstOrDefault();
+            return newest == null ? null : Letterbox(File.ReadAllText(newest.FullName));
+        }
+        catch { return null; }
+    }
+
+    /// <summary>bShouldLetterbox from a VALORANT GameUserSettings.ini (null when it isn't there).</summary>
+    internal static bool? Letterbox(string ini)
+    {
+        foreach (var raw in ini.Split('\n'))
+        {
+            var line = raw.Trim();
+            if (line.StartsWith("bShouldLetterbox=", StringComparison.OrdinalIgnoreCase))
+                return line.EndsWith("True", StringComparison.OrdinalIgnoreCase);
+        }
+        return null;
+    }
+
+    /// <summary>True when the process is VALORANT.</summary>
+    public static bool IsValorant(int pid)
+    {
+        if (pid <= 0) return false;
+        try { using var p = Process.GetProcessById(pid); return p.ProcessName.StartsWith("VALORANT", StringComparison.OrdinalIgnoreCase); }
+        catch { return false; }
+    }
+
+    const int PathSize = 72, ModeSize = 64;
+
+    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+    struct MONITORINFOEX
+    {
+        public int cbSize;
+        public int l, t, r, b, wl, wt, wr, wb;
+        public uint dwFlags;
+        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string szDevice;
+    }
+
+    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+    struct DISPLAYCONFIG_SOURCE_DEVICE_NAME
+    {
+        public uint type, size, adapterLow;
+        public int adapterHigh;
+        public uint id;
+        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string viewGdiDeviceName;
+    }
+
+    [DllImport("user32.dll")] static extern IntPtr MonitorFromWindow(IntPtr hwnd, uint flags);
+    [DllImport("user32.dll", CharSet = CharSet.Unicode)] static extern bool GetMonitorInfo(IntPtr monitor, ref MONITORINFOEX info);
+    [DllImport("user32.dll")] static extern int GetDisplayConfigBufferSizes(uint flags, out uint numPaths, out uint numModes);
+    [DllImport("user32.dll")] static extern int QueryDisplayConfig(uint flags, ref uint numPaths, [Out] byte[] paths, ref uint numModes, [Out] byte[] modes, IntPtr topology);
+    [DllImport("user32.dll")] static extern int DisplayConfigGetDeviceInfo(ref DISPLAYCONFIG_SOURCE_DEVICE_NAME name);
+}
